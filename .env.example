# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=dpl.org.np,www.dpl.org.np
CSRF_TRUSTED_ORIGINS=https://dpl.org.np,https://www.dpl.org.np

# development uses SQLite; production uses PostgreSQL
ENVIRONMENT=production
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.dpl.org.np
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@dpl.org.np
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@dpl.org.np
CONTACT_EMAIL=contact@dpl.org.np

# Donate page payment details (leave blank to hide)
DONATION_BANK_NAME=
DONATION_ACCOUNT_NAME=Dynamic Public Library
DONATION_ACCOUNT_NUMBER=
DONATION_BANK_BRANCH=
DONATION_ESEWA_ID=
DONATION_KHALTI_ID=

# Cloudflare R2 (uploads + backups). Leave R2_ACCOUNT_ID empty to store uploads on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=dpl-media
R2_PRIVATE_BUCKET=dpl-private
R2_BACKUP_BUCKET=dpl-backups
R2_PUBLIC_DOMAIN=media.dpl.org.np
